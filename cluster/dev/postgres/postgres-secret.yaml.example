# TEMPLATE FILE - DO NOT COMMIT ACTUAL SECRETS
# See SECRET_CREATION.md for instructions on creating this secret
#
# This file serves as a reference for the required secret structure.
# Use kubectl to create the actual secret (recommended method).

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: dev
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: YOUR_SECURE_PASSWORD_HERE  # Replace with actual password
  POSTGRES_DB: postgres
